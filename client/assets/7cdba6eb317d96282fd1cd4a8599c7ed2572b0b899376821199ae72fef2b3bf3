    /**
     * 日志等级枚举，与底层WASM日志保持一致
     */
    var LogLevel;
    (function (LogLevel) {
        LogLevel[LogLevel["USEAB"] = -1] = "USEAB";
        LogLevel[LogLevel["NONE"] = 0] = "NONE";
        LogLevel[LogLevel["DEFAULT"] = 1] = "DEFAULT";
        LogLevel[LogLevel["VERBOSE"] = 2] = "VERBOSE";
        LogLevel[LogLevel["DEBUG"] = 3] = "DEBUG";
        LogLevel[LogLevel["INFO"] = 4] = "INFO";
        LogLevel[LogLevel["WARN"] = 5] = "WARN";
        LogLevel[LogLevel["ERROR"] = 6] = "ERROR";
        LogLevel[LogLevel["FATAL"] = 7] = "FATAL";
        LogLevel[LogLevel["SILENT"] = 8] = "SILENT";
