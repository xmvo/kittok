        await Promise.all(Object.keys(useData).map(async (filename) => {
            const normalizedFilename = filename.replace(/\/+$/, '') || '/';
            const segments = normalizedFilename.split('/').filter(Boolean);
            const isDirectoryEntry = filename.endsWith('/');
            if (segments.length === 0) {
                return;
            }
            segments.slice(0, isDirectoryEntry ? segments.length : segments.length - 1).forEach((_, index) => {
                const dirPath = `/${segments.slice(0, index + 1).join('/')}`;
                pathMap.push(dirPath);
                fs.mkdirTree(dirPath);
            });
            if (isDirectoryEntry) {
                pathMap.push(normalizedFilename);
                return;
