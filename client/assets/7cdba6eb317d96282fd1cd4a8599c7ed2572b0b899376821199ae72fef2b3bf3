    const writeDataByPath = async (fs, path, data) => {
        const usePath = decodeURI(path).replaceAll('//', '/');
        const folder = usePath.substring(0, usePath.lastIndexOf('/'));
        const buildMemfsDebugPayload = (phase, error) => ({
            phase,
            originalPath: path,
            normalizedPath: usePath,
            folder,
            dataBytes: data.length,
            errorName: error?.name,
            errorCode: error?.code,
            errno: error?.errno,
            errorMessage: error?.message,
        });
        const attachMemfsDebugContext = (error, phase) => {
            if (error && typeof error === 'object') {
                Object.assign(error, {
                    memfsPhase: phase,
                    memfsOriginalPath: path,
                    memfsNormalizedPath: usePath,
                    memfsFolder: folder,
                    memfsDataBytes: data.length,
                });
            }
            console.error('[ResourceController][memfs] writeDataByPath failed', JSON.stringify(buildMemfsDebugPayload(phase, error)));
            return error;
        };
        try {
            if (folder) {
                try {
                    fs.stat(folder);
                }
                catch {
                    try {
                        fs.mkdirTree(folder);
                        fs.stat(folder);
                    }
                    catch (error) {
                        throw attachMemfsDebugContext(error, 'mkdir-parent');
                    }
                }
            }
            const stream = fs.open(usePath, 'w+');
            fs.write(stream, data, 0, data.length, 0);
            fs.close(stream);
            return usePath;
        }
        catch (error) {
            if (error?.memfsPhase) {
                throw error;
            }
            throw attachMemfsDebugContext(error, 'write-file');
        }
    };
    const loopDirToFs = async (fs, data) => {
        const useData = {};
